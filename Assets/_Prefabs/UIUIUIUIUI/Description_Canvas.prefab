  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB108\uD76C\uB294 \uC774 \uAC74\uBB3C\uC5D0\uC11C \uD0C8\uCD9C\uD574\uC57C
    \uD55C\uB2E4.\r\n\uB9F5 \uACF3\uACF3\uC758 \uD37C\uC990\uC744 \uD480\uACE0, \uCD9C\uAD6C\uB97C
    \uCC3E\uC544\uB77C.\r\n\uB2E8, \uC774 \uC548\uC5D0\uB294 \uB108\uD76C\uB97C \uC0AC\uB0E5\uD558\uB294
    \uBB34\uC5B8\uAC00\uAC00 \uC788\uB2E4. \r\n\r\nWASD : \uC774\uB3D9\r\n\uC88C\uD074\uB9AD
    : \uC624\uBE0C\uC81D\uD2B8 \uC870\uC791\r\n\uC6B0\uD074\uB9AD: \uD300\uC6D0\uACFC
    \uC74C\uC131 \uD1B5\uC2E0(\uBB34\uC804\uAE30)\r\nESC : \uBA54\uB274\r\n\r\n\uAD34\uBB3C\uC740
    \uC18C\uB9AC\uC640 \uC2DC\uC57C\uB85C \uB108\uB97C \uAC10\uC9C0\uD55C\uB2E4.\r\n\uC870\uC6A9\uD788,
    \uADF8\uB9AC\uACE0 \uC2DC\uC120\uC744 \uD53C\uD574 \uC6C0\uC9C1\uC5EC\uB77C.
    \r\n\r\n\uD63C\uC790\uC120 \uC0B4\uC544\uB0A8\uAE30 \uC5B4\uB835\uB2E4.\r\n\uD300\uC6D0\uC774
    \uC7A1\uD614\uB2E4\uBA74 \uAD6C\uCD9C\uC744 \uC2DC\uB3C4\uD558\uB77C.\r\n\uC804\uC6D0
    \uC0AC\uB9DD \uB610\uB294 \uD0C8\uCD9C \uC2E4\uD328 \uC2DC \uAC8C\uC784 \uC624\uBC84.\r\n"
